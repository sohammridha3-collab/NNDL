# ====================================================================
# Inclusive ATS - Environment Variables Template (Backend Directory)
# ====================================================================

SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

HOST=127.0.0.1
PORT=8001

DATABASE_URL=sqlite:///./inclusive_ats.db

ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000,http://localhost:8001,http://127.0.0.1:8001

MODEL_PATH=app/ml/artifacts/model.pkl
DEVICE=cpu
ENABLE_BIAS_MASKING=true

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

ENABLE_EXTERNAL_JOBS=true
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us
