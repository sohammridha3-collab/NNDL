# ====================================================================
# Inclusive ATS - Backend Environment Variables Template
# Copy this file to .env or backend/.env and adjust variables.
# ====================================================================

# Security
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server Configuration
HOST=127.0.0.1
PORT=8001

# Database Configuration
# Uses root SQLite database by default; supports PostgreSQL or MySQL
DATABASE_URL=sqlite:///./inclusive_ats.db

# CORS Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000,http://localhost:8001,http://127.0.0.1:8001

# Machine Learning & Inference Settings
MODEL_PATH=app/ml/artifacts/model.pkl
DEVICE=cpu
ENABLE_BIAS_MASKING=true

# File Upload Settings
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# External Job Search APIs (Live Genuine Vacancies)
# To search live vacancies across Kolkata, Delhi, Bengaluru and other Indian locations:
# 1. Sign up for a free developer account at https://developer.adzuna.com/signup
# 2. Copy your Application ID and Application Key into the placeholders below:
ENABLE_EXTERNAL_JOBS=true
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here
ADZUNA_COUNTRY=in
