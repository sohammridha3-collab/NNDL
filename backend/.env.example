# ==========================================
# Inclusive Resume and Job Matching System
# SDG 10: Reduced Inequalities - Environment Configuration
# ==========================================

# Environment Mode
ENVIRONMENT=production

# Security & JWT
SECRET_KEY=generate-a-secure-random-secret-key-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (MySQL recommended for production, SQLite supported as fallback)
DATABASE_URL=mysql+pymysql://root:YOUR_MYSQL_PASSWORD@localhost:3306/inclusive_ats
# For Render hosted database:
# DATABASE_URL=mysql+pymysql://user:password@render-mysql-host.oregon-postgres.render.com/inclusive_ats

# Allowed Frontend Origins (Comma-separated, no trailing slashes)
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://localhost:3000,http://localhost:5173,https://YOUR-FRONTEND.onrender.com

# Model & Inference Settings
MODEL_PATH=app/ml/artifacts/model.pkl
DEVICE=cpu
ENABLE_BIAS_MASKING=true

# Storage Settings
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
